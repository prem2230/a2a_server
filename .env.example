PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/a2a-commerce
JWT_SECRET=replace-with-a-long-random-secret
MODEL_API_KEY=your-gemini-api-key
MODEL_NAME=gemini-3.1-flash-lite
MODEL_FALLBACK_NAME=gemini-3.8-flash
GEMINI_RETRY_ATTEMPTS=3
# true skips model API calls; false uses MODEL_API_KEY and falls back to demo if the service fails.
IS_DEMO=false
CLIENT_ORIGIN=http://localhost:3000
ADMIN_API_KEY=replace-with-a-separate-long-random-admin-key
ESCROW_ENCRYPTION_KEY=base64-encoded-32-byte-key
